  "narrative": [
    { "type": "description", "text": "The Ashenmere Autumn Festival transforms the Old Town Square. Lanterns, chestnuts, music. For one day, the divisions of politics seem distant." },
    { "type": "description", "text": "But you are still the Chancellor. The factions are here too — watching, waiting. You cannot talk to everyone." }
  ],
