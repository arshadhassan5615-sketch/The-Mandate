      "title": "The Festival Speech",
      "location": "Main Stage",
      "mandatory": true,
      "narrative": [
        { "type": "description", "text": "The festival organizers have reserved a brief address from the Chancellor. The crowd is a mix of families, workers, students." },
        { "type": "dialogue", "character": "jonas_ashavel", "text": "Let me do this one. I've been working on something. About community." }
      ],
      "choices": [
        {
          "id": "fest_speech_chancellor",
